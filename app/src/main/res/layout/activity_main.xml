<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Arbi Run Coach" android:textSize="30sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/subtitle" android:text="Personal running coach" android:textSize="16sp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/connect" android:text="Connect Strava" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Belum terhubung" android:layout_marginTop="18dp" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/plan" android:text="Target pertama: Half Marathon • 29 Nov 2026\n\nTraining plan akan muncul setelah Strava tersambung." android:layout_marginTop="28dp" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
